# Copy this file to .env and fill in your own values.
# Only VITE_ prefixed variables are exposed to the browser bundle.
# Never put the Supabase service_role key here.

VITE_SUPABASE_API_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_API_KEY=your-supabase-anon-public-key
VITE_WHATSAPP_NUMBER=201000000000
